generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Valores monetários são sempre guardados em centavos (Int) para evitar erros de ponto flutuante.

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  activeGroupId String?
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  transactions  Transaction[] @relation("TxPerson")
  cards         Card[]
  refreshTokens RefreshToken[]
}

/// Refresh tokens são rotacionados a cada uso. Guardamos só o hash.
model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id                  String         @id @default(cuid())
  name                String
  initialBalanceCents Int            @default(0)
  createdAt           DateTime       @default(now())
  members             Membership[]
  invites             Invite[]
  categories          Category[]
  cards               Card[]
  transactions        Transaction[]
  shoppingItems       ShoppingItem[]
  dashboards          Dashboard[]
}

enum Role {
  OWNER
  MEMBER
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Invite {
  id          String    @id @default(cuid())
  groupId     String
  token       String    @unique
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

enum TxType {
  INCOME
  EXPENSE
}

/// Categoria (ou subcategoria, quando tem parentId — ex.: Streaming › Netflix). Só um nível de profundidade.
/// icon: nome de ícone do Iconify ("ph:house-line-duotone", "simple-icons:netflix") ou emoji legado.
model Category {
  id           String        @id @default(cuid())
  groupId      String
  parentId     String?
  name         String
  kind         TxType        @default(EXPENSE)
  color        String        @default("#8A05BE")
  icon         String        @default("ph:tag-duotone")
  createdAt    DateTime      @default(now())
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]

  @@index([groupId])
}

model Card {
  id           String         @id @default(cuid())
  groupId      String
  ownerId      String?
  name         String
  limitCents   Int
  closingDay   Int            @default(25)
  dueDay       Int            @default(5)
  color        String         @default("#8A05BE")
  archived     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  group        Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  owner        User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  shopping     ShoppingItem[]
}

enum AmountMode {
  FIXED
  PERCENT
}

/// Sobre o que o percentual incide (ex.: dízimo).
enum PercentBase {
  /// Todas as entradas da pessoa
  PERSON_INCOME
  /// Todas as entradas do grupo
  GROUP_INCOME
  /// Só os salários da pessoa (empréstimos e rendas extras ficam de fora)
  PERSON_SALARY
  /// Só os salários do grupo
  GROUP_SALARY
  /// Uma entrada específica (percentBaseTxId) — ex.: 10% do salário do dia 5
  TRANSACTION
}

enum PaymentMethod {
  PIX
  BOLETO
  CARD
  DEBIT
  CASH
  TRANSFER
}

enum Recurrence {
  ONCE
  MONTHLY
  INSTALLMENTS
}

model Transaction {
  id               String          @id @default(cuid())
  groupId          String
  /// Pessoa dona da entrada/saída (de quem é o salário, quem paga)
  personId         String?
  createdById      String
  type             TxType
  description      String
  categoryId       String?
  amountMode       AmountMode      @default(FIXED)
  /// Valor de cada ocorrência (para parcelado: valor da parcela)
  amountCents      Int             @default(0)
  /// Percentual em pontos-base (1000 = 10%)
  percentBp        Int?
  percentBase      PercentBase?
  /// Entrada usada como base quando percentBase = TRANSACTION
  percentBaseTxId  String?
  /// Série original quando o lançamento foi dividido ("alterar a partir deste mês"):
  /// percentuais vinculados à entrada continuam valendo depois de um aumento de salário.
  seriesId         String?
  paymentMethod    PaymentMethod?
  cardId           String?
  /// Data da compra / primeira ocorrência
  date             DateTime        @db.Date
  recurrence       Recurrence      @default(ONCE)
  /// MONTHLY: quantidade de meses (null = sem fim). INSTALLMENTS: total de parcelas
  totalMonths      Int?
  /// Parcela em que a série começa (ex.: já estou na 3/6)
  installmentStart Int             @default(1)
  isSalary         Boolean         @default(false)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  group            Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person           User?           @relation("TxPerson", fields: [personId], references: [id], onDelete: SetNull)
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  card             Card?           @relation(fields: [cardId], references: [id], onDelete: SetNull)
  occurrences      TxOccurrence[]
  percentBaseTx    Transaction?    @relation("PercentBase", fields: [percentBaseTxId], references: [id], onDelete: SetNull)
  percentDependents Transaction[]  @relation("PercentBase")

  @@index([groupId])
}

/// Estado de uma ocorrência num mês específico (pago, valor ajustado, pulado)
model TxOccurrence {
  id            String      @id @default(cuid())
  transactionId String
  /// "YYYY-MM"
  month         String
  paid          Boolean     @default(false)
  paidAt        DateTime?
  amountCents   Int?
  skipped       Boolean     @default(false)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, month])
}

enum ShoppingStatus {
  PLANNED
  BOUGHT
}

model ShoppingItem {
  id             String         @id @default(cuid())
  groupId        String
  name           String
  estimatedCents Int
  paymentMethod  PaymentMethod  @default(PIX)
  cardId         String?
  installments   Int            @default(1)
  /// "YYYY-MM" — mês em que pretende comprar
  plannedMonth   String?
  priority       Int            @default(2)
  status         ShoppingStatus @default(PLANNED)
  transactionId  String?
  notes          String?
  link           String?
  createdAt      DateTime       @default(now())
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  card           Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
}

/// Dashboard personalizado: os widgets (tipo de gráfico + consulta) ficam num JSON validado pela API.
model Dashboard {
  id          String   @id @default(cuid())
  groupId     String
  createdById String
  name        String
  icon        String   @default("📊")
  position    Int      @default(0)
  widgets     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}
